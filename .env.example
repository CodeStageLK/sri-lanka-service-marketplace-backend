NODE_ENV=development
PORT=3000

# --- Neon-managed variables ---
# Run `neon env pull` (or `neon deploy`) to write the real values into .env.local.
# Never commit .env.local. Do not hand-edit these values.
# Neon PostgreSQL: pooled URL for the application, direct URL for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Neon Object Storage (S3-compatible, AWS-standard variable names).
AWS_ACCESS_KEY_ID=neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=neon-storage-secret-access-key
AWS_ENDPOINT_URL_S3=https://storage.region.aws.neon.tech/example
AWS_REGION=us-east-2

# --- Application variables ---
# Bucket declared in neon.ts (default: assets).
STORAGE_BUCKET=assets
# Examples only. Generate independent random values for each environment.
JWT_ACCESS_SECRET=replace-this-example-access-secret-before-use
JWT_REFRESH_SECRET=replace-this-example-refresh-secret-before-use
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Set both together to validate JWT issuer and audience claims.
# JWT_ISSUER=https://api.example.com
# JWT_AUDIENCE=serv-hub-clients
AUTH_APP_URL=http://localhost:5173

# Required in production. Leave unset locally to use the non-delivering
# development email adapter; it never logs verification or reset tokens.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@example.com

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
